   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 🧹 Step 4: Text Preprocessing Pipeline"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize tools\n",
    "tokenizer_tweet = TweetTokenizer(preserve_case=False, strip_handles=True, reduce_len=True)\n",
    "lemmatizer = WordNetLemmatizer()\n",
    "stop_words = set(stopwords.words('english'))\n",
    "\n",
    "# Preserve negations - important for hate speech\n",
    "negations = {'no', 'not', 'nor', 'neither', 'never', 'none', 'nobody', 'nothing', 'nowhere'}\n",
    "stop_words = stop_words - negations\n",
    "\n",
    "def preprocess_text(text):\n",
    "    \"\"\"\n",
    "    Multi-stage preprocessing pipeline for social media text.\n",
    "    Based on methodology from research paper.\n",
    "    \"\"\"\n",
    "    text = str(text)\n",
    "\n",
    "    # Step 1: Text Normalization\n",
    "    text = text.lower()                                          # Lowercase\n",
    "    text = text.encode('ascii', 'ignore').decode('ascii')        # Remove unicode\n",
    "\n",
    "    # Step 2: Social Media Specific Cleaning\n",
    "    text = re.sub(r'http\\S+|www\\S+', '', text)                  # Remove URLs\n",
    "    text = re.sub(r'@\\w+', '<USER>', text)                       # Replace mentions\n",
    "    text = re.sub(r'#(\\w+)', lambda m: m.group(1), text)        # Process hashtags\n",
    "    text = re.sub(r'RT\\s+', '', text)                            # Remove retweet marker\n",
    "\n",
    "    # Step 3: Tokenization\n",
    "    tokens = tokenizer_tweet.tokenize(text)\n",
    "\n",
    "    # Step 4: Stop word removal + Lemmatization\n",
    "    tokens = [\n",
    "        lemmatizer.lemmatize(token)\n",
    "        for token in tokens\n",
    "        if token not in stop_words\n",
    "        and token not in string.punctuation\n",
    "        and len(token) > 1\n",
    "    ]\n",
    "\n",
    "    return ' '.join(tokens)\n",
    "\n",
    "# Apply preprocessing\n",
    "print('🔄 Preprocessing tweets...')\n",
    "df['cleaned_tweet'] = df['tweet'].apply(preprocess_text)\n",
    "print('✅ Preprocessing complete!')\n",
    "\n",
    "# Show before/after\n",
    "print('\\nExample:')\n",
    "print('BEFORE:', df['tweet'].iloc[0])\n",
    "print('AFTER: ', df['cleaned_tweet'].iloc[0])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 🔢 Step 5: Feature Extraction & Tokenization"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Hyperparameters (from research paper)\n",
    "MAX_WORDS = 5000      # Vocabulary size\n",
    "MAX_LEN   = 50        # Max sequence length\n",
    "EMBED_DIM = 100       # Embedding dimensions\n",
    "\n",
    "# Tokenize\n",
    "tokenizer = Tokenizer(num_words=MAX_WORDS, oov_token='<OOV>')\n",
    "tokenizer.fit_on_texts(df['cleaned_tweet'])\n",
    "\n",
    "# Convert to sequences\n",
    "X = tokenizer.texts_to_sequences(df['cleaned_tweet'])\n",
    "X = pad_sequences(X, maxlen=MAX_LEN, padding='post', truncating='post')\n",
    "\n",
    "# Labels\n",
    "y = df['class'].values\n",
    "y_cat = to_categorical(y, num_classes=3)\n",
    "\n",
    "print(f'Vocabulary size: {len(tokenizer.word_index)}')\n",
    "print(f'Input shape: {X.shape}')\n",
    "print(f'Label shape: {y_cat.shape}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train/Test Split (80/20 stratified)\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y_cat, test_size=0.2, random_state=42, stratify=y\n",
    ")\n",
    "\n",
    "print(f'Training samples: {X_train.shape[0]}')\n",
    "print(f'Testing samples:  {X_test.shape[0]}')\n",
    "\n",
    "# Compute class weights to handle imbalance\n",
    "class_weights = compute_class_weight(\n",
    "    class_weight='balanced',\n",
    "    classes=np.unique(y),\n",
    "    y=y\n",
    ")\n",
    "class_weight_dict = dict(enumerate(class_weights))\n",
    "print(f'\\nClass weights: {class_weight_dict}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 🧠 Step 6: Build BiLSTM Model with Attention"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Custom Attention Layer\n",
    "class AttentionLayer(Layer):\n",
    "    def __init__(self, **kwargs):\n",
    "        super(AttentionLayer, self).__init__(**kwargs)\n",
    "\n",
    "    def build(self, input_shape):\n",
    "        self.W = self.add_weight(\n",
    "            name='att_weight',\n",
    "            shape=(input_shape[-1], 1),\n",
    "            initializer='normal'\n",
    "        )\n",
    "        self.b = self.add_weight(\n",
    "            name='att_bias',\n",
    "            shape=(input_shape[1], 1),\n",
    "            initializer='zeros'\n",
    "        )\n",
    "        super(AttentionLayer, self).build(input_shape)\n",
    "\n",
    "    def call(self, x):\n",
    "        e = tf.keras.backend.tanh(\n",
    "            tf.keras.backend.dot(x, self.W) + self.b\n",
    "        )\n",
    "        a = tf.keras.backend.softmax(e, axis=1)\n",
    "        output = x * a\n",
    "        return tf.keras.backend.sum(output, axis=1)\n",
    "\n",
    "# Build Model\n",
    "def build_bilstm_attention_model(vocab_size, embed_dim, max_len):\n",
    "    inputs = Input(shape=(max_len,))\n",
    "\n",
    "    # Embedding Layer\n",
    "    x = Embedding(vocab_size, embed_dim, input_length=max_len)(inputs)\n",
    "\n",
    "    # BiLSTM Layer 1\n",
    "    x = Bidirectional(LSTM(128, return_sequences=True, activation='tanh'))(x)\n",
    "    x = Dropout(0.5)(x)\n",
    "\n",
    "    # BiLSTM Layer 2\n",
    "    x = Bidirectional(LSTM(64, return_sequences=True, activation='tanh'))(x)\n",
    "    x = Dropout(0.5)(x)\n",
    "\n",
    "    # Attention Layer\n",
    "    x = AttentionLayer()(x)\n",
    "\n",
    "    # Dense Layer\n",
    "    x = Dense(64, activation='relu')(x)\n",
    "    x = Dropout(0.3)(x)\n",
    "\n",
    "    # Output Layer\n",
    "    outputs = Dense(3, activation='softmax')(x)\n",
    "\n",
    "    model = Model(inputs, outputs)\n",
    "    return model\n",
    "\n",
    "model = build_bilstm_attention_model(MAX_WORDS, EMBED_DIM, MAX_LEN)\n",
    "\n",
    "model.compile(\n",
    "    optimizer=tf.keras.optimizers.Adam(learning_rate=0.001),\n",
    "    loss='categorical_crossentropy',\n",
    "    metrics=['accuracy']\n",
    ")\n",
    "\n",
    "model.summary()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 🏋️ Step 7: Train the Model"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Callbacks\n",
    "early_stop = EarlyStopping(\n",
    "    monitor='val_loss', patience=3,\n",
    "    restore_best_weights=True, verbose=1\n",
    ")\n",
    "reduce_lr = ReduceLROnPlateau(\n",
    "    monitor='val_loss', factor=0.2,\n",
    "    patience=2, min_lr=0.00001, verbose=1\n",
    ")\n",
    "\n",
    "# Train\n",
    "history = model.fit(\n",
    "    X_train, y_train,\n",
    "    validation_split=0.1,\n",
    "    epochs=10,\n",
    "    batch_size=64,\n",
    "    class_weight=class_weight_dict,\n",
    "    callbacks=[early_stop, reduce_lr],\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "print('\\n✅ Training complete!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 📈 Step 8: Training Curves"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Accuracy\n",
    "axes[0].plot(history.history['accuracy'], label='Train', color='#0077b6', linewidth=2)\n",
    "axes[0].plot(history.history['val_accuracy'], label='Validation', color='#ff6b6b', linewidth=2)\n",
    "axes[0].set_title('Model Accuracy', fontsize=14, fontweight='bold')\n",
    "axes[0].set_xlabel('Epoch')\n",
    "axes[0].set_ylabel('Accuracy')\n",
    "axes[0].legend()\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "# Loss\n",
    "axes[1].plot(history.history['loss'], label='Train', color='#0077b6', linewidth=2)\n",
    "axes[1].plot(history.history['val_loss'], label='Validation', color='#ff6b6b', linewidth=2)\n",
    "axes[1].set_title('Model Loss', fontsize=14, fontweight='bold')\n",
    "axes[1].set_xlabel('Epoch')\n",
    "axes[1].set_ylabel('Loss')\n",
    "axes[1].legend()\n",
    "axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('training_curves.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 📊 Step 9: Model Evaluation"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Predictions\n",
    "y_pred_proba = model.predict(X_test)\n",
    "y_pred = np.argmax(y_pred_proba, axis=1)\n",
    "y_true = np.argmax(y_test, axis=1)\n",
    "\n",
    "# Accuracy\n",
    "accuracy = accuracy_score(y_true, y_pred)\n",
    "print(f'\\n✅ Test Accuracy: {accuracy:.4f} ({accuracy*100:.2f}%)')\n",
    "\n",
    "# Classification Report\n",
    "class_names = ['Hate Speech', 'Offensive', 'Neutral']\n",
    "print('\\n📋 Classification Report:')\n",
    "print(classification_report(y_true, y_pred, target_names=class_names))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Confusion Matrix\n",
    "cm = confusion_matrix(y_true, y_pred)\n",
    "\n",
    "plt.figure(figsize=(8, 6))\n",
    "sns.heatmap(\n",
    "    cm, annot=True, fmt='d',\n",
    "    xticklabels=class_names,\n",
    "    yticklabels=class_names,\n",
    "    cmap='Blues',\n",
    "    linewidths=0.5\n",
    ")\n",
    "plt.title('Confusion Matrix', fontsize=14, fontweight='bold')\n",
    "plt.ylabel('True Label')\n",
    "plt.xlabel('Predicted Label')\n",
    "plt.tight_layout()\n",
    "plt.savefig('confusion_matrix.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ROC Curves\n",
    "y_test_bin = label_binarize(y_true, classes=[0, 1, 2])\n",
    "colors = ['#ff6b6b', '#ffd93d', '#6bcb77']\n",
    "\n",
    "plt.figure(figsize=(8, 6))\n",
    "for i, (name, color) in enumerate(zip(class_names, colors)):\n",
    "    fpr, tpr, _ = roc_curve(y_test_bin[:, i], y_pred_proba[:, i])\n",
    "    roc_auc = auc(fpr, tpr)\n",
    "    plt.plot(fpr, tpr, color=color, linewidth=2,\n",
    "             label=f'{name} (AUC = {roc_auc:.2f})')\n",
    "\n",
    "plt.plot([0, 1], [0, 1], 'k--', linewidth=1)\n",
    "plt.xlim([0.0, 1.0])\n",
    "plt.ylim([0.0, 1.05])\n",
    "plt.xlabel('False Positive Rate', fontsize=12)\n",
    "plt.ylabel('True Positive Rate', fontsize=12)\n",
    "plt.title('ROC Curves by Class', fontsize=14, fontweight='bold')\n",
    "plt.legend(loc='lower right')\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.savefig('roc_curves.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 🔮 Step 10: Predict on New Text"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def predict_hate_speech(text):\n",
    "    \"\"\"\n",
    "    Predict the class of a given text.\n",
    "    Returns: class label and confidence score\n",
    "    \"\"\"\n",
    "    cleaned = preprocess_text(text)\n",
    "    seq = tokenizer.texts_to_sequences([cleaned])\n",
    "    padded = pad_sequences(seq, maxlen=MAX_LEN, padding='post')\n",
    "    pred = model.predict(padded, verbose=0)\n",
    "    class_idx = np.argmax(pred)\n",
    "    confidence = pred[0][class_idx]\n",
    "    label = class_names[class_idx]\n",
    "    return label, confidence\n",
    "\n",
    "# Test with sample texts\n",
    "test_texts = [\n",
    "    \"I love spending time with my friends and family!\",\n",
    "    \"This is absolutely ridiculous and stupid.\",\n",
    "]\n",
    "\n",
    "print('🔮 Predictions:')\n",
    "print('-' * 50)\n",
    "for text in test_texts:\n",
    "    label, confidence = predict_hate_speech(text)\n",
    "    emoji = '🟢' if label == 'Neutral' else ('🟡' if label == 'Offensive' else '🔴')\n",
    "    print(f'{emoji} Text: \"{text[:50]}...\"')\n",
    "    print(f'   Class: {label} | Confidence: {confidence:.2%}\\n')"
   ]
  },
  {
